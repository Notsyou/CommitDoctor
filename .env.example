# --- Server ---
PORT=3000

# --- GitHub webhook ---
# The same secret you type into GitHub > Settings > Webhooks > Secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GITHUB_WEBHOOK_SECRET=change-me

# Optional. Restrict Commit Doctor to ONE repository (owner/name).
# Events from any other repository are ignored. Leave empty to accept any.
GITHUB_REPO=

# --- Summary rules (these map to the study's design questions) ---
# IANA timezone that defines when a "day" starts and ends.
TIMEZONE=Asia/Manila
# Only save a daily summary when at least this many commits were made.
SUMMARY_MIN_COMMITS=1
# How many previous days form the baseline for "compared to recent days".
SUMMARY_COMPARISON_DAYS=7

# --- Storage ---
DB_PATH=./data/commitdoctor.db

# Optional. If set, POST /api/summaries/:date/generate requires
# the header "Authorization: Bearer <token>".
ADMIN_TOKEN=
